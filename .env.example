# ==================================================
# DARUKAA.EARTH PLATFORM ENVIRONMENT VARIABLES
# ==================================================

# --------------------------------------------------
# BACKEND FASTAPI CONFIGURATION
# --------------------------------------------------
PROJECT_NAME="Darukaa.Earth Backend"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL (Defaults to local Docker PostgreSQL with PostGIS)
# For local Docker: DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/darukaa_earth"
# For Supabase (Hosted PostgreSQL + PostGIS): DATABASE_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/darukaa_earth"

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --------------------------------------------------
# FRONTEND REACT VITE CONFIGURATION
# --------------------------------------------------
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Mapbox Public Access Token (Required for Mapbox GL JS Satellite Vector Tiles)
# Get a free public token from https://account.mapbox.com/
VITE_MAPBOX_TOKEN="pk.eyJ1IjoiZGVtbyIsImEiOiJjbGV4YW1wbGUifQ..."
