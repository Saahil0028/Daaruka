{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "private": true,
  "description": "Darukaa.Earth Full-Stack Geospatial Data Analytics Platform",
  "scripts": {
    "prepare": "husky install || true",
    "pre-commit": "lint-staged",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\"",
    "format:write": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\"",
    "test:frontend": "npm run test --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  }
}
